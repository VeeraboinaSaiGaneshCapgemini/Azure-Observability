      "targets": [
        {
          "azureLogAnalytics": {
            "dashboardTime": false,
            "mode": "raw",
            "query": "// Pull latest 'Average' per DB and pivot to one row with three columns\r\nlet perDb =\r\n    AzureMetrics\r\n    | where TimeGenerated between($__timeFrom() .. $__timeTo())\r\n    | where MetricName == \"allocated_data_storage\"\r\n    | where ResourceId endswith(\"/databases/sqldb\")\r\n      or ResourceId endswith(\"/databases/SSISDB\")\r\n    | summarize arg_max(TimeGenerated, *) by ResourceId\r\n    | extend Size_Bytes = todouble(Average)                     // metric is in bytes\r\n    | extend Size_MB = Size_Bytes /1000000                     // decimal MB\r\n    | project ResourceId, Size_MB;\r\n\r\nperDb\r\n| summarize\r\n    SQL1_MB = maxif(Size_MB, ResourceId endswith(\"/databases/sqldb\")),\r\n    SQL2_MB = maxif(Size_MB, ResourceId endswith(\"/databases/SSISDB\"))\r\n| extend Combined_MB = round(SQL1_MB + SQL2_MB, 2)\r\n| project Combined_MB\r\n",
            "resources": [
              "/subscriptions/262a3c1d-7fe3-4bfb-9f90-7a5b89109336/resourceGroups/Idea2.0/providers/Microsoft.Sql/servers/dataplatform123/databases/sqldb",
              "/subscriptions/262a3c1d-7fe3-4bfb-9f90-7a5b89109336/resourceGroups/Idea2.0/providers/Microsoft.Sql/servers/dataplatform123/databases/SSISDB"
            ],
            "resultFormat": "logs"
          },
          "azureMonitor": {
            "allowedTimeGrainsMs": [],
            "timeGrain": "auto"
          },
          "queryType": "Azure Log Analytics",
          "refId": "A"
        }
      ],
      "title": "Total SQL Instances",
      "type": "stat"
    },
